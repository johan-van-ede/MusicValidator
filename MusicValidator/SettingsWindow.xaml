<Window x:Class="MusicValidator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Validator Settings"
        Width="640"
        Height="520"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        Foreground="#E8EDF5"
        FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Configure how Music Validator finds files and checks them."
                 Margin="0,5,0,0"
                 Foreground="{StaticResource MutedBrush}"
                 FontSize="12" />
    </StackPanel>

    <TabControl Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource LineBrush}"
                Foreground="#E8EDF5">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
          <Setter Property="Background" Value="{StaticResource PanelBackground}" />
          <Setter Property="Padding" Value="14,9" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder"
                        Margin="0,0,4,0"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,0,2">
                  <ContentPresenter ContentSource="Header" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#E8EDF5" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E8EDF5" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      <TabItem Header="Folders">
        <StackPanel Margin="20">
          <TextBlock Text="Music folder" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="When selected, the app scans this folder when it starts."
                     Margin="0,5,0,9"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="12" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MusicFolderTextBox"
                     IsReadOnly="True"
                     Padding="8,7"
                     Background="{StaticResource HeaderBackground}"
                     Foreground="#E8EDF5"
                     BorderBrush="{StaticResource LineBrush}"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Button Grid.Column="1"
                    Content="Browse"
                    Margin="8,0,0,0"
                    Click="BrowseMusicFolder_Click" />
          </Grid>
          <TextBlock Text="Purchase folder" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,0" />
          <TextBlock Text="Purchase records are saved here; audio files stay in their original locations."
                     Margin="0,5,0,9"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="12"
                     TextWrapping="Wrap" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PurchaseFolderTextBox"
                     IsReadOnly="True"
                     Padding="8,7"
                     Background="{StaticResource HeaderBackground}"
                     Foreground="#E8EDF5"
                     BorderBrush="{StaticResource LineBrush}"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Button Grid.Column="1"
                    Content="Browse"
                    Margin="8,0,0,0"
                    Click="BrowsePurchaseFolder_Click" />
          </Grid>
        </StackPanel>
      </TabItem>
      <TabItem Header="Scanning">
        <StackPanel Margin="20">
          <TextBlock Text="Folder scanning" FontSize="14" FontWeight="SemiBold" />
          <CheckBox x:Name="IncludeSubfoldersCheckBox"
                    Content="Include subfolders"
                    Margin="0,14,0,20"
                    Foreground="#E8EDF5"
                    IsChecked="True" />
          <TextBlock Text="Audio file types to include"
                     Margin="0,0,0,10"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="12" />
          <Border Padding="14" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5">
            <WrapPanel x:Name="AudioFormatsPanel" />
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="Validation">
        <TextBlock Text="Validation settings will be available here."
                   Margin="20"
                   Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Top" />
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" MinWidth="84" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Content="Save" MinWidth="84" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
