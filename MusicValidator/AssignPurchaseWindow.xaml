<Window x:Class="MusicValidator.AssignPurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign songs to purchase"
        Width="620"
        Height="560"
        MinWidth="520"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        Foreground="#E8EDF5"
        FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Assign songs to a purchase" FontSize="20" FontWeight="SemiBold" />
      <TextBlock x:Name="SongCountText"
                 Margin="0,5,0,0"
                 Foreground="{StaticResource MutedBrush}"
                 FontSize="12" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <TextBlock Text="SELECT PURCHASE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
      <ComboBox x:Name="PurchaseComboBox"
                DisplayMemberPath="DisplayLabel"
                Padding="8,7" />
    </StackPanel>

    <ListBox x:Name="SongsListBox"
             Grid.Row="2"
             Background="{StaticResource HeaderBackground}"
             Foreground="#E8EDF5"
             BorderBrush="{StaticResource LineBrush}"
             BorderThickness="1"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4,3">
            <TextBlock Text="{Binding Title}" FontSize="12" />
            <TextBlock Text="{Binding Artist}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Button Content="Create new purchase"
              HorizontalAlignment="Left"
              Click="CreatePurchase_Click" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" MinWidth="84" Margin="0,0,8,0" Click="Cancel_Click" />
        <Button Content="Assign songs" MinWidth="100" Click="Assign_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
