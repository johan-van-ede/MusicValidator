<Window x:Class="MusicValidator.AddPurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add purchase"
        Width="560"
        Height="430"
        MinWidth="500"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}"
        Foreground="#E8EDF5"
        FontFamily="Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="Add purchase" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Enter the purchase details first. You can attach songs from its details view."
                 Margin="0,5,0,0"
                 Foreground="{StaticResource MutedBrush}"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="1.5*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="PURCHASE DATE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
        <DatePicker x:Name="PurchaseDatePicker" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0">
        <TextBlock Text="STORE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
        <TextBox x:Name="StoreTextBox" Padding="8,7" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="PURCHASE PRICE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
        <TextBox x:Name="PriceTextBox" Padding="8,7" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2"
            Margin="0,22,0,0"
            Padding="16"
            Background="{StaticResource HeaderBackground}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="5">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Songs can be added later"
                   FontSize="13"
                   FontWeight="SemiBold" />
        <TextBlock Text="Save this purchase, then open its details and select the songs from disk."
                   Margin="0,6,0,0"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Cancel" MinWidth="84" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Content="Save purchase" MinWidth="112" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
