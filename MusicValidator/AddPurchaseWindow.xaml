<Window x:Class="MusicValidator.AddPurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add purchase"
        Width="640"
        Height="700"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        Foreground="#E8EDF5"
        FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="ReadOnlyPurchaseValueBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style x:Key="EditablePurchaseValueTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="Foreground" Value="#E8EDF5" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="#E8EDF5" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="TextBoxBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="WindowTitleText" Text="Add purchase" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="WindowDescriptionText"
                   Text="Save without evidence. Add a PDF, a native file, or both for each proof type; required proof types validate automatically."
                   Margin="0,5,0,0"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Button x:Name="LegacyImportButton"
              Grid.Column="1"
              Content="Import legacy"
              ToolTip="Fill purchase details from a legacy legality report"
              Padding="8,4"
              Margin="12,0,0,0"
              FontSize="10"
              Background="Transparent"
              BorderThickness="0"
              Foreground="{StaticResource MutedBrush}"
              VerticalAlignment="Top"
              Click="ImportLegacy_Click" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="PURCHASE DATE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
            <DatePicker x:Name="PurchaseDatePicker"
                        Height="34"
                        VerticalContentAlignment="Center" />
            <Border x:Name="PurchaseDateReadOnly"
                    Style="{StaticResource ReadOnlyPurchaseValueBorder}"
                    Visibility="Collapsed">
              <TextBlock x:Name="PurchaseDateReadOnlyText" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="STORE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
            <ComboBox x:Name="StoreComboBox"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True"
                      Height="34"
                      VerticalContentAlignment="Center"
                      Padding="8,0" />
            <Border x:Name="StoreReadOnly"
                    Style="{StaticResource ReadOnlyPurchaseValueBorder}"
                    Visibility="Collapsed">
              <TextBlock x:Name="StoreReadOnlyText" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
              <TextBlock Text="PURCHASE PRICE (€)" Foreground="{StaticResource MutedBrush}" FontSize="10" />
              <TextBlock Text=" *"
                         Foreground="#E06B75"
                         FontSize="11"
                         ToolTip="A purchase price is required unless you mark it as unknown." />
            </StackPanel>
            <TextBox x:Name="PriceTextBox"
                     Style="{StaticResource EditablePurchaseValueTextBox}"
                     Height="34"
                     VerticalContentAlignment="Center" />
            <CheckBox x:Name="PriceUnknownCheckBox"
                      Content="Amount unknown"
                      Margin="0,5,0,0"
                      Foreground="{StaticResource MutedBrush}"
                      FontSize="11"
                      Checked="PriceUnknownCheckBox_Changed"
                      Unchecked="PriceUnknownCheckBox_Changed" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.5*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="MUSIC MEDIUM" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
            <ComboBox x:Name="PurchaseKindComboBox"
                      Height="34"
                      VerticalContentAlignment="Center"
                      Padding="8,0"
                      SelectionChanged="PurchaseKindComboBox_SelectionChanged">
              <ComboBoxItem Content="Physical" Tag="Physical" />
              <ComboBoxItem Content="Digital" Tag="Digital" />
            </ComboBox>
            <Border x:Name="PurchaseKindReadOnly"
                    Style="{StaticResource ReadOnlyPurchaseValueBorder}"
                    Visibility="Collapsed">
              <TextBlock x:Name="PurchaseKindReadOnlyText" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="PAYMENT METHOD" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
            <ComboBox x:Name="PaymentMethodComboBox"
                      Height="34"
                      VerticalContentAlignment="Center"
                      Padding="8,0"
                      SelectionChanged="PaymentMethodComboBox_SelectionChanged">
              <ComboBoxItem Content="Cash" Tag="Cash" />
              <ComboBoxItem Content="Digital" Tag="Digital" />
            </ComboBox>
            <Border x:Name="PaymentMethodReadOnly"
                    Style="{StaticResource ReadOnlyPurchaseValueBorder}"
                    Visibility="Collapsed">
              <TextBlock x:Name="PaymentMethodReadOnlyText" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="REMARK"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       Margin="0,0,0,7" />
            <Grid x:Name="RemarkInputGrid">
              <TextBox x:Name="RemarkTextBox"
                       Height="34"
                       Padding="8,0,44,0"
                       VerticalContentAlignment="Center"
                       MaxLength="25" />
              <TextBlock x:Name="RemarkCharacterCountText"
                         Text="0/25"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="0,0,9,0"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="10"
                         IsHitTestVisible="False" />
            </Grid>
            <Border x:Name="RemarkReadOnly"
                    Style="{StaticResource ReadOnlyPurchaseValueBorder}"
                    Visibility="Collapsed">
              <TextBlock x:Name="RemarkReadOnlyText"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Grid>

        <CheckBox x:Name="UnknownPhysicalAlbumCheckBox"
                  Content="Physical album; purchase details unknown"
                  Margin="0,12,0,0"
                  Foreground="{StaticResource MutedBrush}"
                  Visibility="Collapsed"
                  Checked="UnknownPhysicalAlbumCheckBox_Changed"
                  Unchecked="UnknownPhysicalAlbumCheckBox_Changed" />

        <StackPanel x:Name="PossessionProofPanel" Visibility="Collapsed" Margin="0,18,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <TextBlock Text="PROOF OF OWNERSHIP (PHYSICAL PURCHASE)"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10" />
            <TextBlock Text=" *"
                       Foreground="#E06B75"
                       FontSize="11"
                       ToolTip="Required for automatic validation, but not for saving." />
          </StackPanel>
          <DockPanel LastChildFill="True">
            <StackPanel x:Name="PossessionProofSelector" DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="PossessionProofPdfButton"
                      Content="PDF"
                      ToolTip="Select a PDF"
                      Tag="PossessionPdf"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
              <Button x:Name="PossessionProofFileButton"
                      Content="File"
                      ToolTip="Select a non-PDF native file"
                      Tag="PossessionFile"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
            </StackPanel>
            <TextBlock x:Name="PossessionProofFileText"
                       Text="No file selected"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>

        <StackPanel x:Name="PaymentProofPanel" Visibility="Collapsed" Margin="0,18,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <TextBlock Text="PROOF OF PAYMENT (DIGITAL PAYMENT)"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10" />
            <TextBlock Text=" *"
                       Foreground="#E06B75"
                       FontSize="11"
                       ToolTip="Required for automatic validation, but not for saving." />
          </StackPanel>
          <DockPanel LastChildFill="True">
            <StackPanel x:Name="PaymentProofSelector" DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="PaymentProofPdfButton"
                      Content="PDF"
                      ToolTip="Select a PDF"
                      Tag="PaymentPdf"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
              <Button x:Name="PaymentProofFileButton"
                      Content="File"
                      ToolTip="Select a non-PDF native file"
                      Tag="PaymentFile"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
            </StackPanel>
            <TextBlock x:Name="PaymentProofFileText"
                       Text="No file selected"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>

        <StackPanel x:Name="PurchaseProofPanel" Margin="0,18,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <TextBlock Text="PROOF OF PURCHASE"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10" />
            <TextBlock x:Name="PurchaseProofRequiredIndicator"
                       Text=" *"
                       Foreground="#E06B75"
                       FontSize="11"
                       ToolTip="Required for automatic validation, but not for saving." />
          </StackPanel>
          <DockPanel LastChildFill="True">
            <StackPanel x:Name="PurchaseProofSelector" DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="PurchaseProofPdfButton"
                      Content="PDF"
                      ToolTip="Select a PDF"
                      Tag="PurchasePdf"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
              <Button x:Name="PurchaseProofFileButton"
                      Content="File"
                      ToolTip="Select a non-PDF native file"
                      Tag="PurchaseFile"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
            </StackPanel>
            <TextBlock x:Name="PurchaseProofFileText"
                       Text="No file selected"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>

        <CheckBox x:Name="ManualValidationCheckBox"
                  Content="Manually validate this purchase despite missing evidence"
                  Margin="0,18,0,0"
                  Foreground="{StaticResource MutedBrush}"
                  ToolTip="Use only when you have reviewed the purchase and confirmed it is valid." />

        <Border Margin="0,22,0,12"
                Padding="16"
                Background="{StaticResource HeaderBackground}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="5">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Songs can be added later"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <TextBlock Text="Save this purchase, then open its details and select the songs from disk."
                       Margin="0,6,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" MinWidth="84" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button x:Name="SavePurchaseButton" Content="Save purchase" MinWidth="112" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
