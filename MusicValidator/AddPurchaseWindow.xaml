<Window x:Class="MusicValidator.AddPurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add purchase"
        Width="640"
        Height="700"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        Foreground="#E8EDF5"
        FontFamily="Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,18">
      <TextBlock x:Name="WindowTitleText" Text="Add purchase" FontSize="20" FontWeight="SemiBold" />
      <TextBlock x:Name="WindowDescriptionText"
                 Text="Save without evidence. Add a PDF, a native file, or both for each proof type; required proof types validate automatically."
                 Margin="0,5,0,0"
                 Foreground="{StaticResource MutedBrush}"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="PURCHASE DATE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
            <DatePicker x:Name="PurchaseDatePicker"
                        Height="34"
                        VerticalContentAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="STORE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
            <ComboBox x:Name="StoreComboBox"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True"
                      Height="34"
                      VerticalContentAlignment="Center"
                      Padding="8,0" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="PURCHASE PRICE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
            <TextBox x:Name="PriceTextBox"
                     Height="34"
                     Padding="8,0"
                     VerticalContentAlignment="Center" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="PURCHASE TYPE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
            <ComboBox x:Name="PurchaseKindComboBox"
                      Height="34"
                      VerticalContentAlignment="Center"
                      Padding="8,0"
                      SelectionChanged="PurchaseKindComboBox_SelectionChanged">
              <ComboBoxItem Content="Physical" Tag="Physical" />
              <ComboBoxItem Content="Digital" Tag="Digital" />
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="PAYMENT METHOD" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
            <ComboBox x:Name="PaymentMethodComboBox"
                      Height="34"
                      VerticalContentAlignment="Center"
                      Padding="8,0"
                      SelectionChanged="PaymentMethodComboBox_SelectionChanged">
              <ComboBoxItem Content="Cash" Tag="Cash" />
              <ComboBoxItem Content="Digital" Tag="Digital" />
            </ComboBox>
          </StackPanel>
        </Grid>

        <StackPanel Margin="0,16,0,0">
          <TextBlock Text="REMARK (OPTIONAL)"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="10"
                     Margin="0,0,0,7" />
          <TextBox x:Name="RemarkTextBox"
                   Height="34"
                   Padding="8,0"
                   VerticalContentAlignment="Center"
                   MaxLength="100" />
        </StackPanel>

        <StackPanel x:Name="PossessionProofPanel" Visibility="Collapsed" Margin="0,18,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <TextBlock Text="PROOF OF OWNERSHIP (PHYSICAL PURCHASE)"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10" />
            <TextBlock Text=" *"
                       Foreground="#E06B75"
                       FontSize="11"
                       ToolTip="Required for automatic validation, but not for saving." />
          </StackPanel>
          <DockPanel LastChildFill="True">
            <StackPanel x:Name="PossessionProofSelector" DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="PDF"
                      ToolTip="Select a PDF"
                      Tag="PossessionPdf"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
              <Button Content="File"
                      ToolTip="Select a non-PDF native file"
                      Tag="PossessionFile"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
            </StackPanel>
            <TextBlock x:Name="PossessionProofFileText"
                       Text="No file selected"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>

        <StackPanel x:Name="PaymentProofPanel" Visibility="Collapsed" Margin="0,18,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <TextBlock Text="PROOF OF PAYMENT (DIGITAL PAYMENT)"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10" />
            <TextBlock Text=" *"
                       Foreground="#E06B75"
                       FontSize="11"
                       ToolTip="Required for automatic validation, but not for saving." />
          </StackPanel>
          <DockPanel LastChildFill="True">
            <StackPanel x:Name="PaymentProofSelector" DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="PDF"
                      ToolTip="Select a PDF"
                      Tag="PaymentPdf"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
              <Button Content="File"
                      ToolTip="Select a non-PDF native file"
                      Tag="PaymentFile"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
            </StackPanel>
            <TextBlock x:Name="PaymentProofFileText"
                       Text="No file selected"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>

        <StackPanel x:Name="PurchaseProofPanel" Margin="0,18,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <TextBlock Text="PROOF OF PURCHASE"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10" />
            <TextBlock Text=" *"
                       Foreground="#E06B75"
                       FontSize="11"
                       ToolTip="Required for automatic validation, but not for saving." />
          </StackPanel>
          <DockPanel LastChildFill="True">
            <StackPanel x:Name="PurchaseProofSelector" DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="PDF"
                      ToolTip="Select a PDF"
                      Tag="PurchasePdf"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
              <Button Content="File"
                      ToolTip="Select a non-PDF native file"
                      Tag="PurchaseFile"
                      Padding="8,5"
                      Margin="6,0,0,0"
                      Click="SelectProof_Click" />
            </StackPanel>
            <TextBlock x:Name="PurchaseProofFileText"
                       Text="No file selected"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>

        <CheckBox x:Name="ManualValidationCheckBox"
                  Content="Manually validate this purchase despite missing evidence"
                  Margin="0,18,0,0"
                  Foreground="{StaticResource MutedBrush}"
                  ToolTip="Use only when you have reviewed the purchase and confirmed it is valid." />

        <Border Margin="0,22,0,12"
                Padding="16"
                Background="{StaticResource HeaderBackground}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="5">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Songs can be added later"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <TextBlock Text="Save this purchase, then open its details and select the songs from disk."
                       Margin="0,6,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" MinWidth="84" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button x:Name="SavePurchaseButton" Content="Save purchase" MinWidth="112" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
